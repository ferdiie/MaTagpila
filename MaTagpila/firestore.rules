// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── prices collection ─────────────────────────────────────────────────
    // Anyone logged in can read all prices (community price checker)
    // Only the person who added an entry can update/delete it
    match /prices/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.addedBy == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.price is number
        && request.resource.data.price > 0;

      allow update: if request.auth != null
        && resource.data.addedBy == request.auth.token.email;

      allow delete: if request.auth != null
        && resource.data.addedBy == request.auth.token.email;
    }

    // ── Block everything else ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
